# Used only by `vite --mode emulator` (npm run dev:emu).
# Demo values for the local Firebase emulator. No secrets here: a "demo-*"
# project never reaches a real Firebase project. Safe to commit.
#
# These override any value with the same name in .env, so every Firebase and
# Cloudinary variable the app reads is set here on purpose.
VITE_USE_EMULATOR=true
VITE_EMULATOR_HOST=127.0.0.1

VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-ez.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-ez
VITE_FIREBASE_STORAGE_BUCKET=demo-ez.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_VAPID_KEY=

# Empty on purpose: image uploads stay off in emulator mode instead of
# reaching the real Cloudinary account.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
