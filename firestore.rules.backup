rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Users collection
    match /users/{userId} {
      // Anyone authenticated can read user documents (needed for admin check)
      allow read: if request.auth != null;

      // Users can update their own profile
      allow update: if request.auth != null && request.auth.uid == userId;

      // Admins can create/update any user
      allow create, update: if isAdmin();
    }

    // Posts collection (blog)
    match /posts/{postId} {
      // Anyone can read published posts
      // Authenticated users can read all posts (for slug checking)
      allow read: if resource.data.published == true || request.auth != null;

      // Only admins can create, update, delete posts
      allow create, update, delete: if isAdmin();
    }

    // Default deny for other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
