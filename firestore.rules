rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to get user role
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && getUserRole() == 'admin';
    }
    
    // Helper function to check if user is editor or admin
    function isEditorOrAdmin() {
      return request.auth != null && (getUserRole() == 'editor' || getUserRole() == 'admin');
    }
    
    // Articles collection
    match /articles/{article} {
      // Anyone can read articles (public)
      allow read: if true;
      
      // Any authenticated user can create articles
      allow create: if request.auth != null;
      
      // Authors can only update their own articles
      // Editors and Admins can update any article
      allow update: if request.auth != null && 
        (resource.data.author.uid == request.auth.uid || isEditorOrAdmin());
      
      // Only Editors and Admins can delete articles
      allow delete: if isEditorOrAdmin();
    }
    
    // Users collection
    match /users/{userId} {
      // Users can always read their own profile (needed for role check)
      // Admins can read all profiles
      allow read: if request.auth != null && 
        (request.auth.uid == userId || 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
      
      // Only Admins can create or update user profiles
      allow create, update: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      
      // Admins can delete users, but not themselves
      allow delete: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' &&
        request.auth.uid != userId;
    }
    
    // Default deny for other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
