rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // Helper function to check if user is editor or admin
    function isEditor() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["admin", "editor"];
    }

    // Users collection: authenticated users can read their own, admins can read all and manage
    // Users can also create their own document (self-registration via team invite)
    match /users/{userId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        isAdmin() ||
        resource.data.role in ['admin', 'editor']
      );
      allow create: if isAdmin() ||
        (request.auth != null && request.auth.uid == userId);
      allow update, delete: if isAdmin();
    }

    // Posts collection: public can read published, editors can CRUD
    match /posts/{postId} {
      allow read: if resource.data.published == true || isEditor();
      allow create, update, delete: if isEditor();
    }

    // Workouts collection: admins can CRUD, athletes can read assigned workouts
    match /workouts/{workoutId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    // Workout assignments: admins can CRUD, athletes can read their own and update completion
    match /workoutAssignments/{assignmentId} {
      allow read: if request.auth != null &&
        (isAdmin() || resource.data.athleteId == request.auth.uid);
      allow create, delete: if isAdmin();
      allow update: if isAdmin() ||
        (request.auth != null && resource.data.athleteId == request.auth.uid);
    }

    // Exercises collection: admins can CRUD, authenticated users can read
    match /exercises/{exerciseId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    // Chat rules: Admin can read/write any chat. Participants can read/write their own.
    match /chats/{chatId} {
      allow read: if request.auth != null && (
        isAdmin() || 
        (resource != null && request.auth.uid in resource.data.participantIds) ||
        // Allow reading non-existent docs if the ID implies involvement (for creation checks)
        // Assumes ID format: id1_id2
        (resource == null && chatId.matches('.*' + request.auth.uid + '.*'))
      );
      
      allow create: if request.auth != null && (
        isAdmin() || 
        request.auth.uid in request.resource.data.participantIds
      );
      
      allow update: if request.auth != null && (
        isAdmin() || 
        request.auth.uid in resource.data.participantIds
      );
      
      allow delete: if isAdmin();
      
      match /messages/{messageId} {
        allow read, write: if request.auth != null && (
          isAdmin() || 
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds
        );
      }
    }

    // Subscription history: admins can read/write all, athletes can read their own
    match /subscriptionHistory/{historyId} {
      allow read: if request.auth != null && 
        (isAdmin() || resource.data.athleteId == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    // Teams collection
    match /teams/{teamId} {
      // Public read: allows unauthenticated lookup by inviteToken on the join page
      allow read: if true;

      // Only the team's coach (coachId) can create or delete
      allow create: if request.auth != null
        && request.resource.data.coachId == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.coachId == request.auth.uid;

      // Coach can update anything.
      // An authenticated user can append only their own UID to memberIds (team join).
      allow update: if request.auth != null && (
        resource.data.coachId == request.auth.uid
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["memberIds", "updatedAt"])
          && request.resource.data.memberIds.hasAll(resource.data.memberIds)
          && request.resource.data.memberIds.removeAll(resource.data.memberIds).hasOnly([request.auth.uid])
        )
      );
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
